# Station Window environment — copy to .env and adjust. All services default
# to loopback; never expose the API or database on public interfaces in dev.

# PostgreSQL (docker-compose publishes 127.0.0.1:55432 → container 5432)
SW_DATABASE_URL=postgres://station:station_local_dev@127.0.0.1:55432/station_window

# API bind — loopback by default, port 8787 (the Vite dev proxy targets this)
SW_HOST=127.0.0.1
SW_PORT=8787

# Deployment mode: dev | replay | competition.
# Live Delphi transport is established ONLY in competition mode AND with the
# explicit submissions opt-in AND provider credentials. dev/replay never transmit.
SW_MODE=dev
SW_LIVE_SUBMISSIONS=no

# Delphi provider credentials — leave empty for all local work.
# Never commit real values.
DELPHI_BASE_URL=
DELPHI_API_KEY=
DELPHI_ACCOUNT=default
DELPHI_AGENT_ID=station-window

# Fetch limits for source connectors
SW_FETCH_MAX_BYTES=2000000
SW_FETCH_TIMEOUT_MS=15000
